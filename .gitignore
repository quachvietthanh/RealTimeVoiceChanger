# Python byte code and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution and packaging
build/
dist/
*.egg-info/
.eggs/
third_party/


# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Logs and runtime outputs
*.log
logs/
output/
runs/
benchmarks/

# Audio data and private recordings
recordings/
temp_audio/
*.raw
*.pcm
private_audio/
data/
tests/fixtures/*.wav
tests/fixtures/*.mp3
tests/fixtures/*.flac
tests/fixtures/*.ogg
tests/fixtures/*.m4a

# Machine learning model weights, checkpoints, and index files
*.pth
*.pt
*.ckpt
*.onnx
*.bin
*.index
models/weights/*
!models/weights/.gitkeep
models/checkpoints/*
!models/checkpoints/.gitkeep
models/indices/*
!models/indices/.gitkeep

# Local configurations, secrets, and environment variables
.env
.env.*
config/*.local.json
config/*.local.yaml
